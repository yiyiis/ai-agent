# 复制为同目录下的 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）
# 注意：MYSQL_ROOT_PASSWORD 需与 backend/etc/config.local.yaml 里的 DBConf.Password 一致

# MySQL root 密码（仅在 mysql-data 卷为空、首次启动时生效；改密码后需重建卷或 ALTER USER）
MYSQL_ROOT_PASSWORD=change_me

# Redis 访问密码（改后重启容器即生效，数据不受影响；后端代码暂未接入 Redis）
REDIS_PASSWORD=change_me

# 容器镜像版本标签（CI/CD 会自动更新记录，回滚时修改此处 SHA 并重启容器）
BACKEND_TAG=main
FRONTEND_TAG=main

# 宿主机回环端口（由宿主机 Caddy/Nginx 反向代理，不直接向公网暴露）
BACKEND_PORT=8002
FRONTEND_PORT=8003
