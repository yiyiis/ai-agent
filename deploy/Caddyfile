# ==============================================================================
# 宿主机 Caddy 生产网关配置模板（对应服务器 /etc/caddy/Caddyfile）
#
# 架构职责：
#   宿主机 Caddy 负责公网 80/443 入口，自动申请与续期 HTTPS 证书。
#   将流量分流到只监听 127.0.0.1 回环的容器服务：
#     /api/* -> 后端容器 (127.0.0.1:8002)
#     /*     -> 前端容器 (127.0.0.1:8003)
# ==============================================================================

# 【模式 1：正式域名上线（自动开通 HTTPS 绿锁）】
# 取消下面的注释并替换为您的域名即可：
#
# ai.yourdomain.com {
#     handle /api/* {
#         reverse_proxy 127.0.0.1:8002 {
#             transport http {
#                 response_header_timeout 600s
#             }
#         }
#     }
#     handle {
#         reverse_proxy 127.0.0.1:8003
#     }
# }

# 【模式 2：纯 IP 临时调试（访问 http://服务器IP）】
:80 {
    handle /api/* {
        reverse_proxy 127.0.0.1:8002 {
            transport http {
                response_header_timeout 600s
            }
        }
    }

    handle {
        reverse_proxy 127.0.0.1:8003
    }
}
